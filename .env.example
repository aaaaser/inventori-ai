# ==============================================================================
# SISTEM INVENTORI & PEMINJAMAN ASET SEKOLAH
# Environment Variables Configuration Template
# ==============================================================================

# Database Connection (Neon / PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://user:password@endpoint-id.region.aws.neon.tech/neondb?sslmode=require"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Sistem Inventori dan Peminjaman Aset Sekolah"

# Session & Authentication Secret Key
SESSION_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"


